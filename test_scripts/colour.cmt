import {test_case, Assert} from 'unittest'

@test_case(Colour(0, 0, 0), COLOUR_CATEGORY.BLACK)
@test_case(Colour(255, 255, 255), COLOUR_CATEGORY.WHITE)
@test_case(Colour(128, 128, 128), COLOUR_CATEGORY.GREY)
@test_case(Colour(255, 0, 0), COLOUR_CATEGORY.RED)
@test_case(Colour(255, 128, 0), COLOUR_CATEGORY.ORANGE)
@test_case(Colour(255, 255, 0), COLOUR_CATEGORY.YELLOW)
@test_case(Colour(0, 255, 0), COLOUR_CATEGORY.GREEN)
@test_case(Colour(0, 255, 255), COLOUR_CATEGORY.CYAN)
@test_case(Colour(0, 0, 255), COLOUR_CATEGORY.BLUE)
@test_case(Colour(255, 0, 255), COLOUR_CATEGORY.MAGENTA)
function test_colour_categorise(colour, category) {
    Assert.that(colour.categorise()).is_equal_to(category)
}